# ============================================================================
# fuelhub-comprobantes -- variables de entorno
# Copia este archivo a .env.local y completa los valores reales.
# IMPORTANTE: este archivo (.env.example) SI se commitea a git -- nunca
# pongas aqui un client_secret ni ningun valor real, solo placeholders.
# Los valores reales van SOLO en .env.local (gitignored).
# ============================================================================

# --- Sesion M2M hacia FuelHub Cloud (App Client NUEVO, scope acotado) -------
# Pendiente crear en Cognito: scope fuelhub-api/comprobantes.read (nuevo,
# hay que agregarlo primero al Resource Server), sin custom:station_scope
# (este endpoint no es por estacion). Ver README.md para el script.
FUELHUB_TOKEN_URL=https://CAMBIAR.auth.us-east-2.amazoncognito.com/oauth2/token
FUELHUB_COMPROBANTES_CLIENT_ID=CAMBIAR
FUELHUB_COMPROBANTES_CLIENT_SECRET=CAMBIAR

# --- API real de FuelHub Cloud ------------------------------------------------
FUELHUB_API_BASE_URL=https://api.fuelhub.cloud

# --- Captcha (Cloudflare Turnstile) -------------------------------------------
# Crea el widget en https://dash.cloudflare.com -> Turnstile. La site key es
# publica (NEXT_PUBLIC_); la secret key SOLO va en .env.local / Vercel.
# Para desarrollo puedes usar las claves de prueba de Cloudflare (siempre pasan):
#   site key  1x00000000000000000000AA
#   secret    1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=CAMBIAR
TURNSTILE_SECRET_KEY=CAMBIAR
